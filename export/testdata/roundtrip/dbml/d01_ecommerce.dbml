Project shop {
  database_type: 'PostgreSQL'
  Note: 'E-commerce schema'
}

Enum order_status {
  pending
  paid [note: 'payment captured']
  shipped
  "on hold"
}

Table users as U {
  id integer [pk, increment]
  email varchar(255) [unique, not null]
  full_name varchar
  created_at timestamp [default: `now()`]
  Note: 'Registered users'
}

Table orders {
  id bigint [pk, increment]
  user_id integer [not null, ref: > U.id]
  status order_status [default: 'pending']
  total decimal(12,2) [not null, default: 0]
  placed_at timestamptz
  indexes {
    (user_id, placed_at) [name: 'idx_orders_user_placed']
    status
  }
}

Table order_items {
  order_id bigint
  line_no int
  sku varchar(64) [not null, note: 'stock keeping unit']
  qty int [default: 1]
  indexes {
    (order_id, line_no) [pk]
  }
}

Ref: order_items.order_id > orders.id [delete: cascade, update: no action]
