Enum app.status {
  active
  "on hold"
}
Enum status {
  a
  b
}
Table app.users [note: 'It\'s users'] {
  id int [pk, increment]
  st app.status [not null]
  st2 status
  cur public.money_t
  cur2 other.money_t
  name varchar [note: 'Bob\'s name', default: 'x']
}
Table public.posts {
  id bigint [pk, increment]
  user_id int [ref: > app.users.id]
  t "timestamp with time zone" [default: `now()`]
  Note: 'posts'
}
Table other.tags {
  id smallint [pk, increment]
  name "My Type"
}
Ref: app.users.id <> other.tags.id
Ref: posts.id <> other.tags.id
Ref r1: posts.user_id - other.tags.id [delete: cascade, update: set null]
