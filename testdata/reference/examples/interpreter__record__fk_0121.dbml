
Table merchants {
  id int
  country_code varchar

  indexes {
    (id, country_code) [pk]
  }
}
Table orders {
  id int [pk]
  merchant_id int
  country varchar
  status varchar
}
Ref: orders.(merchant_id, country) >? merchants.(id, country_code)

records merchants(id, country_code) {
  1, "US"
}
records orders(id, merchant_id, country, status) {
  1, 1, "US", "confirmed"
  2, null, "UK", "pending"
  3, 1, null, "processing"
}
