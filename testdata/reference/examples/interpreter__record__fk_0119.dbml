
Table merchants {
  id int
  country_code varchar

  indexes {
    (id, country_code) [pk]
  }
}
Table orders {
  id int [pk]
  merchant_id int
  country varchar
  amount decimal
}
Ref: orders.(merchant_id, country) > merchants.(id, country_code)

records merchants(id, country_code) {
  1, "US"
  1, "UK"
  2, "US"
}
records orders(id, merchant_id, country, amount) {
  1, 1, "US", 100.00
  2, 1, "UK", 200.50
  3, 2, "US", 50.00
}
