
TablePartial timestamps {
  created_by int [ref: > users.id]
}

Table users {
  id int [pk]
  name varchar
}

Table posts {
  id int [pk]
  title varchar
  ~timestamps
}

Table comments {
  id int [pk]
  content varchar
  ~timestamps
}

records users(id, name) {
  1, "Alice"
  2, "Bob"
}

records posts(id, title, created_by) {
  1, "Post 1", 1
  2, "Post 2", 2
}

records comments(id, content, created_by) {
  1, "Comment 1", 1
  2, "Comment 2", 999
}
