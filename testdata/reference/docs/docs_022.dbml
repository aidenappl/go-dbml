enum Status {
  active
  inactive
  pending
}

Table users {
  id int
  name varchar
  age int
  status Status
  created_at timestamp
}

records users(id, name, age, status, created_at) {
  1, 'Alice', 30, Status.active, '2024-01-15 10:30:00'
  2, 'Bob', null, 'inactive', `now()`
  3, 'Charlie', , Status.pending, '2024-01-15'
}
