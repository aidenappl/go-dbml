Table "user" {
  "id" int [pk]
  "name" string
}

Table "country" {
  "id" int [pk]
  "name" string [not null]
  Note: 'name is required'
}

Table "product" {
  "id" int [pk]
  "name" string
  "price" decimal [not null]
  Note: 'product must have price'
}

Table "merchant" {
  "id" int [pk]
  "user_id" int
  "product_id" int
  "address" string
  Note: 'merchants sell a lot'
}

Ref:"user"."id" < "merchant"."user_id"

Ref:"product"."id" < "merchant"."product_id"
