Table "users" {
  "id" integer [pk]
}

Table "posts" {
  "user_id" integer [not null]
  "editor_id" int
  "owner_id" int [unique]
  "other_id" int
}

Table "posts_users" {
  "posts_other_id" int
  "users_id" integer

  Indexes {
    (posts_other_id, users_id) [pk]
  }
}

Ref:"users"."id" < "posts"."user_id"

Ref:"posts"."editor_id" < "users"."id"

Ref:"users"."id" < "posts"."owner_id"

Ref:"posts"."other_id" < "posts_users"."posts_other_id"

Ref:"users"."id" < "posts_users"."users_id"
