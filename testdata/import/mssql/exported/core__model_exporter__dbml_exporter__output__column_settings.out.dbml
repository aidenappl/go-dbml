Table "ecommerce"."merchants" {
  "id" int
  "country_code" int [not null, note: 'country_code is required']
  "merchant_name" nvarchar(255)
  "created at" nvarchar(255) [note: 'the time the merchant record was created']
  "admin_id" int [not null, note: 'admin_id is required']

  Indexes {
    (id, country_code) [pk]
  }
}

Table "ecommerce"."order_items" {
  "order_id" int [not null, note: 'order_id is required']
  "product_id" int [not null, note: 'product_id is required']
  "quantity" int [default: 1]
}

Table "ecommerce"."orders" {
  "id" int [pk]
  "user_id" int [unique, not null]
  "status" nvarchar(255)
  "created_at" nvarchar(255) [note: 'When order created']
}

Table "ecommerce"."products" {
  "id" int [pk]
  "name" nvarchar(255)
  "merchant_id" int [not null]
  "price" int
  "status" nvarchar(255) [check: `[status] IN ('out_of_stock', 'in_stock', 'running_low')`]
  "created_at" datetime [default: `now()`]

  Indexes {
    (merchant_id, status) [name: "product_status"]
    id [unique, name: "products_index_1"]
  }
}

Table "ecommerce"."product_tags" {
  "id" int [pk]
  "name" nvarchar(255)
}

Table "ecommerce"."merchant_periods" {
  "id" int [pk]
  "merchant_id" int [not null]
  "country_code" int [not null]
  "start_date" datetime
  "end_date" datetime
}

Table "ecommerce"."product_tags_products" {
  "product_tags_id" int
  "products_id" int

  Indexes {
    (product_tags_id, products_id) [pk]
  }
}

Table "users" {
  "id" int [pk, increment]
  "full_name" nvarchar(255)
  "created_at" timestamp
  "country_code" int [not null]
}

Table "countries" {
  "code" int [pk]
  "name" nvarchar(255)
  "continent_name" nvarchar(255)
}

Ref:"users"."id" < "ecommerce"."merchants"."admin_id"

Ref:"countries"."code" < "users"."country_code"

Ref:"countries"."code" < "ecommerce"."merchants"."country_code"

Ref:"ecommerce"."orders"."id" < "ecommerce"."order_items"."order_id"

Ref:"ecommerce"."products"."id" < "ecommerce"."order_items"."product_id"

Ref:"ecommerce"."merchants"."id" < "ecommerce"."products"."merchant_id"

Ref:"ecommerce"."product_tags"."id" < "ecommerce"."product_tags_products"."product_tags_id"

Ref:"ecommerce"."products"."id" < "ecommerce"."product_tags_products"."products_id"

Ref:"ecommerce"."merchants".("id", "country_code") < "ecommerce"."merchant_periods".("merchant_id", "country_code")
