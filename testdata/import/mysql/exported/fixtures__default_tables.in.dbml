Table "orders" {
  "id" int [pk, default: 123]
  "user_id" int [unique, not null]
  "status" varchar(255) [default: 'Completed']
  "created_at" varchar(255) [default: `now()`]
}

Table "order_items" {
  "order_id" int
  "product_id" int
  "quantity" int
}

Table "products" {
  "id" int [pk]
  "name" varchar(255)
  "merchant_id" int [not null, default: `-1`]
  "price" float [default: `-123.12`]
  "stock" boolean [default: true]
  "expiration" date [default: `current_date+interval1year`]
}
