}

Table "schemaA"."products" {
  "id" int [pk]
  "name" varchar(255) [note: 'Product name of schemaA']
  "lid" int

  Indexes {
    (id, name) [name: "product_status"]
  }
}

Table "schemaA"."locations" {
  "id" int [pk]
  "name" varchar(255)
}
