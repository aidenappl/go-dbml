Table "users" {
  "id" int [pk]
  "full_name" varchar(255)
  "email" varchar(255) [unique]
  "gender" varchar(255)
  "date_of_birth" varchar(255)
  "created_at" varchar(255)
  "country_code" int
  "active" boolean [not null]

  Indexes {
    id [unique, name: "users_index_0"]
    full_name [name: "User Name"]
    (email, created_at) [type: hash, name: "users_index_2"]
    `(now())` [name: "users_index_3"]
    (`(lower(full_name))`, active) [name: "users_index_4"]
    (`(getdate())`, `(upper(gender))`) [name: "users_index_5"]
    `(reverse(country_code))` [name: "users_index_6"]
  }
}
