Table "users" {
  "id" int [pk]
  "name" varchar(255)
}

Table "countries" {
  "code" varchar(2) [pk]
  "name" varchar(255)
}

Table "accounts" {
  "id" int [pk]
  "name" varchar(255)
}

Records users(id, name) {
  1, 'Alice'
  2, 'Bob'
}

Records countries(code, name) {
  'US', 'United States'
  'UK', 'United Kingdom'
}

Records accounts(id, name) {
  0, 'Default Account'
  1, 'User Account'
  2, 'Business Account'
}
