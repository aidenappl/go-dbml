Table "user_profiles" {
  "user_id" int
  "profile_type" varchar(255)
  "data" text

  Indexes {
    (user_id, profile_type) [unique, name: "user_profiles_index_0"]
  }
}

Records user_profiles(user_id, profile_type, data) {
  1, 'work', 'Software Engineer'
  1, 'personal', 'Loves hiking'
  2, 'work', 'Designer'
}
