Table "test_datatypes" {
  "col_number" NUMBER(10,2)
  "col_varchar2" VARCHAR2(100)
  "col_char" CHAR(10)
  "col_date" DATE
  "col_timestamp" TIMESTAMP
  "col_clob" CLOB
  "col_raw" RAW(100)
  "col_float" FLOAT
  "col_integer" INTEGER
  "col_nvarchar2" NVARCHAR2(100)
  "col_nchar" NCHAR(10)

  Indexes {
    col_number [pk]
    col_varchar2 [pk]
    col_char [pk]
    col_date [pk]
    col_timestamp [pk]
    col_clob [pk]
    col_raw [pk]
    col_float [pk]
    col_integer [pk]
    col_nvarchar2 [pk]
    col_nchar [pk]
  }
}

Table "order_details" {
  "order_id" NUMBER(10)
  "item_id" NUMBER(10)
  "quantity" NUMBER(10)
  "order_date" DATE

  Indexes {
    (order_id, item_id) [pk]
  }
}

Table "reports" {
  "report_id" NUMBER(10)
  "report_name" VARCHAR2(100)
  "report_date" DATE
  "status" VARCHAR2(20)

  Indexes {
    report_id [pk]
  }
}

Table "sales" {
  "sale_id" NUMBER(10)
  "sale_date" DATE
  "amount" NUMBER(12,2)

  Indexes {
    sale_id [pk]
  }
}

Table "accounts" {
  "account_id" NUMBER(10)
  "account_number" VARCHAR2(20)
  "balance" NUMBER(12,2)

  Indexes {
    account_id [pk]
  }
}
