Enum "job_status" {
  "created2"
  "running2"
  "done2"
  "failure2"
}

Enum "gender" {
  "male2"
  "female2"
}

Table "users" {
  "id" int [pk]
  "name" varchar
  "pjs" job_status
  "pjs2" job_status
  "pg" "schemaB"."schemaB".gender
  "pg2" gender
}

Table "products" {
  "id" int [pk]
  "name" varchar
}

Ref:"ecommerce"."users"."id" ?<? "schemaA"."products"."name"

Ref:"users"."id" ?<? "schemaA"."locations"."name"

Ref:"users"."id" <? "ecommerce"."users"."id"

Ref "name_optional":"users"."name" <? "ecommerce"."users"."id"

Enum "schemaB"."gender" {
  "male"
  "female"
}

Table "ecommerce"."users" {
  "id" int [pk]
  "name" varchar
  "ejs" job_status
  "ejs2" job_status
  "eg" "schemaB"."schemaB".gender
  "eg2" gender
}

Table "schemaA"."products" {
  "id" int [pk]
  "name" varchar
}

Table "schemaA"."locations" {
  "id" int [pk]
  "name" varchar
}
