Table "users" {
  "id" int
  "full_name" varchar
  "email" varchar [unique]
  "gender" varchar
  "date_of_birth" varchar
  "created_at" varchar
  "country_code" int
  "active" boolean

  Indexes {
    (id, full_name, gender) [pk]
    id [unique]
    full_name [name: "User Name"]
    (email, created_at) [type: hash]
    `(now())`
    (active, `((lower(full_name)))`)
    (`(getdate())`, `(upper(gender))`)
    `(reverse(country_code))`
  }
}

Table "products" {
  "id" int [pk, default: 123]
  "name" varchar [default: 'Tea']
  "merchant_id" int [not null]
  "price" float [default: 123.12]
  "status" varchar
  "created_at" varchar [default: `now()`]
  "stock" boolean [default: true]
  "expiration" date [default: `current_date+interval'1 year'`]
}
